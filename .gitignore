# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# app storage & data (never commit user uploads / db)
/storage
/data
/uploads
*.sqlite
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output and test reports
/dist
/test-results
/playwright-report

# written by setup.sh (the nginx block holds nothing secret, but it is yours)
/modlight.nginx.conf

# secrets that must never be committed
*.key
*.pfx
*.p12
cookies.txt
