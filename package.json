{
  "name": "modlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && pnpm build:server",
    "build:server": "esbuild ./server.ts ./migrate.ts ./scripts/fix-mime-types.ts ./scripts/backfill-av-metadata.ts ./scripts/publish-release.ts --platform=node --format=esm --bundle --packages=external --outdir=dist && node ./scripts/check-server-bundle.mjs",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:auth": "better-auth-cli generate --output lib/db/schema/auth-schema.ts --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx migrate.ts",
    "db:fix-mime": "tsx scripts/fix-mime-types.ts",
    "db:av-meta": "tsx scripts/backfill-av-metadata.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:fix-mime:prod": "node dist/scripts/fix-mime-types.js",
    "db:av-meta:prod": "node dist/scripts/backfill-av-metadata.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/lib-storage": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1058.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.100.14",
    "@tus/file-store": "^2.1.0",
    "@tus/s3-store": "^2.0.4",
    "@tus/server": "^2.4.1",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.13",
    "blurhash": "^2.0.5",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.1",
    "media-chrome": "^4.19.2",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "shadcn": "^4.10.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
