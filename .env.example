# ──────────────────────────────────────────────────────────────────────────
# Modlight — environment configuration
#
# Production: run ./setup.sh, which writes .env for you (and keeps its secrets
# when you run it again). This file documents every variable it can set.
# Development: cp .env.example .env — the defaults below work as they are.
# ──────────────────────────────────────────────────────────────────────────

# Public base URL (NO trailing slash). Used for generated links, ShareX config, embeds.
APP_URL=http://localhost:8420
APP_NAME=Modlight

# Name that link previews sign themselves with (og:site_name and the oEmbed
# provider). A card pasted into Discord belongs to the domain it came from, not
# to the product, and saying both just says the same thing twice - so this is
# deliberately NOT APP_NAME, which still names the panel, the page titles and
# the ShareX config.
# Leave it unset: the default is the brand inside APP_URL, which is the same for
# every hostname of one deployment (host.example.com / h.example.com / s.example.com -> "example",
# files.example.co.uk -> "example"). Set it only when the domain is not what the
# site is called. Runtime only, so changing it needs a restart, not a rebuild.
# EMBED_BRAND=example

# Every hostname this deployment answers on, comma-separated (NO trailing slash).
# One app behind several names: each of them serves every file, so a link made
# with one keeps resolving on all of them, permanently. Listing more than one
# here turns on the per-user "link domain" picker in the profile — users choose
# which name THEIR new links are generated with. APP_URL is always included and
# is the default; leave this unset for a single-hostname install.
# Only origins listed here are accepted — a stored value that is not on the list
# silently falls back to APP_URL, so removing a name here is safe.
# APP_DOMAINS=https://host.example.com,https://h.example.com,https://s.example.com

# HTTP port the Node server listens on for LOCAL dev/run (pnpm dev / pnpm start).
# Picked off the common 3000 so it won't clash with other local Docker apps.
# In the production docker-compose the container always listens on 3000 (behind Caddy).
PORT=8420

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Matches the development database from docker-compose.yml, which publishes
# on 5433 so it cannot clash with a PostgreSQL already running on 5432.
# (The production compose builds its own DATABASE_URL; this line is for dev.)
DATABASE_URL=postgresql://modlight:modlight@localhost:5433/modlight

# REQUIRED IN PRODUCTION — the password baked into DATABASE_URL must not be a
# default like "modlight"/"postgres"/"password"; the app refuses to start if it
# is. The production docker-compose builds DATABASE_URL from this variable:
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
# Hex, not base64: the password is pasted into a URL, and base64's "/" breaks it.
POSTGRES_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Signs session cookies AND e-mail verification links
# (a verified link signs the account in), so a guessable value = account
# takeover. Must be >= 32 characters and must not be a placeholder — the app
# refuses to start in production otherwise.
#   Linux/macOS:  openssl rand -base64 32
#   Windows (PowerShell):
#     [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# In development this may stay empty (an insecure fallback is used + warning).
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: a dedicated 32-byte key (base64) for the secrets stored in the
# `settings` table (SMTP password, registration key). Without it the key is
# derived from AUTH_SECRET, which means rotating AUTH_SECRET makes those
# secrets unreadable and you find out the next time somebody clicks
# "forgot my password". Set this if you ever intend to rotate AUTH_SECRET.
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# SEED ONLY. Copied into the `settings` table on the first migration run and
# never read again: from then on the admin panel owns this switch. Changing it
# later has no effect on an install that has already booted.
# It governs strangers signing THEMSELVES up at /register. An administrator can
# always create accounts from the panel, and the very first account on an empty
# install is always allowed (that account becomes the administrator).
REGISTRATION_ENABLED=false

# ── Storage ────────────────────────────────────────────────────────────────
# driver: local | s3
STORAGE_DRIVER=local
# local driver: absolute or relative path where files are stored
STORAGE_LOCAL_PATH=./data/storage

# s3 driver (S3 / MinIO / R2 / Spaces / Backblaze B2 S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO / path-style endpoints
S3_FORCE_PATH_STYLE=false

# ── Uploads / limits ─────────────────────────────────────────────────────
# Max upload size in bytes (0 = unlimited). Default 0 — large files are the point.
MAX_UPLOAD_SIZE=0
# tus chunk size in bytes (resumable web uploads). 0 = single stream (let tus decide).
TUS_CHUNK_SIZE=52428800
# Where tus stores in-progress uploads before finalize (local driver)
TUS_TMP_PATH=./data/tus

# ── Email (password reset, activation, notifications) ──────────────────────
# Fallback only. Once SMTP is configured in Admin -> Settings, the panel block
# wins IN ITS ENTIRETY and everything below is ignored. Precedence is all or
# nothing on purpose: mixing per field would send the SMTP_PASSWORD below to
# whatever host somebody typed into the panel.
# Leave empty to configure mail from the panel instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465). false = plain connect with opportunistic
# STARTTLS. Consulted only when SMTP_SECURITY below is empty.
SMTP_SECURE=false
# tls | starttls | none. Prefer this over SMTP_SECURE on a new install: on the
# submission port (587) you want "starttls", which REFUSES to continue if the
# server will not upgrade. SMTP_SECURE=false only hopes for the upgrade, so a
# stripped STARTTLS would put SMTP_PASSWORD on the wire in clear.
SMTP_SECURITY=
MAIL_FROM=no-reply@localhost
# Display name beside that address in a recipient's inbox. Empty uses APP_NAME.
# Separate from APP_NAME because the panel's branding and the name on outgoing
# mail are different decisions ("Acme Modlight" in an inbox, "Modlight" in the UI).
MAIL_FROM_NAME=

# ── Misc ───────────────────────────────────────────────────────────────────
# Trust X-Forwarded-* headers (set true behind a reverse proxy).
# The auth rate limiter keys on x-real-ip, so the reverse proxy MUST set it to
# the real peer address (nginx: `proxy_set_header X-Real-IP $remote_addr;`).
TRUST_PROXY=true
# Default per-user disk quota in bytes (-1 = unlimited). Admin-configurable later.
DEFAULT_USER_QUOTA=-1
NODE_ENV=development

# ── Production with Docker Compose (written by setup.sh) ────────────────────
# Which compose files `docker compose` loads, and whether the bundled Caddy
# runs. Leave these out in development: then `docker compose` means the
# development database in ./docker-compose.yml.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker/docker-compose.prod.yml
# COMPOSE_PROFILES=caddy
# Hostnames Caddy obtains certificates for, comma-separated.
# CADDY_SITES=files.example.com, f.example.com
# Behind your own proxy instead of Caddy: also load the file that publishes
# the app on 127.0.0.1:APP_PORT, and leave COMPOSE_PROFILES empty.
# COMPOSE_FILE=docker/docker-compose.prod.yml,docker/docker-compose.expose.yml
# APP_PORT=3000
# Host directory for uploads instead of the "appdata" Docker volume. Must be
# owned by uid 1000.
# MODLIGHT_DATA=/mnt/storage/modlight
